# Copy this file to .env and fill in your own key.
# Never commit .env to GitHub.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Speech-to-text defaults. The model is downloaded on first use.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Mature and steady Mandarin male voice.
TTS_VOICE=zh-CN-YunyangNeural
TTS_RATE=-8%
TTS_VOLUME=+0%
TTS_PITCH=-4Hz
